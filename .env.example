# PostgreSQL connection (matches docker-compose.yml for local development)
DATABASE_URL="postgresql://softro:softro_dev_password@localhost:5432/softro_crm?schema=public"

# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional. Neon's *direct* connection string (host without "-pooler"), used only for migrations.
# If unset, migrations use DATABASE_URL.
DIRECT_URL=""

# Optional. Key for encrypting two-step sign-in secrets in the database (32+ characters).
# If unset, it's derived from SESSION_SECRET. Changing either one means people must set up
# two-step sign-in again, so set it once and don't change it.
ENCRYPTION_KEY=""

# Default currency for deals (ISO code)
DEFAULT_CURRENCY="LKR"

# Public address of the CRM, used in links inside emails and calendar events
APP_URL="https://crm.softrocodelabs.com"

# Website "Start your project" form → POST /api/leads (keep secret, 24+ chars)
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBSITE_LEAD_API_KEY=""
# Optional: who new website leads are assigned to
WEBSITE_LEAD_OWNER_EMAIL=""

# Email through Resend (same account as the website). The domain must be verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Softro CRM <crm@softrocodelabs.com>"

# Protects the 8 am summary job (/api/cron/daily-digest). Any random text, 16+ characters.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# First admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@softrocodelabs.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"
SEED_ADMIN_NAME="Softro Admin"

# Optional. Shows Neon compute hours and data transfer under Settings → System health.
# Neon console → Organization settings → API keys → Project-scoped key for the CRM project (the CRM only reads with it). The project ID is in
# Neon console → your project → Settings (e.g. "summer-bush-30064139"). Database size works without these.
NEON_API_KEY=""
NEON_PROJECT_ID=""

# Optional. Plan limits for the usage panel. Defaults are Neon's free plan (1 GB storage, 100 CU-hours,
# 5 GB transfer a month). Change them if you upgrade.
PLAN_DB_STORAGE_MB=""
PLAN_COMPUTE_HOURS=""
PLAN_TRANSFER_GB=""

# ---------------------------------------------------------------------------------------------
# Not app settings: listed here so you know they exist. Don't put real values in your .env.
#
# Vercel → Preview environment only, and only when Preview has its own Neon branch:
#   MIGRATE_ON_BUILD=true    lets preview deploys apply database changes to that branch.
#                            (Production deploys always apply them.)
#
# GitHub → Settings → Secrets and variables → Actions (used by .github/workflows/backup.yml):
#   BACKUP_DATABASE_URL      Neon production direct connection string (same as DIRECT_URL)
#   BACKUP_PASSPHRASE        locks the nightly backup files. Keep it in the password manager.
# See README → "Deploying" and "Backups and restore".
