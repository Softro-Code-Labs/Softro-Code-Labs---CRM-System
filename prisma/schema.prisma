// Softro Code Labs CRM — database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN // full access, user management, settings
  MANAGER // sees and edits everything, reports
  SALES // works on own leads/deals, sees all companies/contacts
  SUPPORT // tickets, contracts (later phases), read-only sales data
  VIEWER // read-only
}

enum CompanyType {
  PROSPECT
  CUSTOMER
  PARTNER
  VENDOR
  FORMER_CUSTOMER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE_FORM // "Start your project" form on softrocodelabs.com (via /api/leads)
  WHATSAPP
  WEBSITE
  REFERRAL
  LINKEDIN
  EMAIL
  PHONE
  EVENT
  COLD_OUTREACH
  PARTNER
  UPWORK_FIVERR
  OTHER
}

// Matches the services on softrocodelabs.com and its "What would you like to build?" form
enum ServiceType {
  WEBSITE_WEB_APP
  MOBILE_APP
  ONLINE_STORE
  BUSINESS_SYSTEM // ERP, CRM, inventory/POS, booking systems
  AI_AUTOMATION
  CUSTOM_SOFTWARE
  SAAS_PLATFORM // SaaS, LMS, cloud platforms
  LAB_PRODUCT // Softro's own products, e.g. Surelane
  MAINTENANCE_SUPPORT
  NOT_SURE
}

enum PreferredLanguage {
  ENGLISH
  SINHALA
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  TASK
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum ContractType {
  MAINTENANCE // AMC / maintenance after a project
  SUPPORT // support hours or SLA
  HOSTING // hosting, domain, servers
  RETAINER // monthly development retainer
  SUBSCRIPTION // SaaS / Lab product subscription, e.g. Surelane
  OTHER
}

enum ContractStatus {
  ACTIVE
  PAUSED
  ENDED // finished or replaced by a renewal
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketChannel {
  WHATSAPP
  EMAIL
  PHONE
  WEBSITE
  IN_PERSON
  OTHER
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
}

// ─────────────────────────────────────────────────────────────
// Users & access
// ─────────────────────────────────────────────────────────────

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  name               String
  passwordHash       String
  role               Role            @default(SALES)
  isActive           Boolean         @default(true)
  jobTitle           String?
  phone              String?
  lastLoginAt        DateTime?
  // Team: a Sales (or Support/Viewer) user belongs to one Manager, who sees their leads, deals and quotes.
  managerId          String?
  manager            User?           @relation("Team", fields: [managerId], references: [id], onDelete: SetNull)
  teamMembers        User[]          @relation("Team")
  createdLeads       Lead[]          @relation("LeadCreator")
  createdDeals       Deal[]          @relation("DealCreator")
  // Security
  mustChangePassword Boolean         @default(false) // set for new users and after an admin reset
  sessionVersion     Int             @default(0) // bump to sign the user out everywhere
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime? // temporary lock after too many wrong passwords
  passwordChangedAt  DateTime?
  // Notifications & integrations
  emailNotifications Boolean         @default(true) // email me when something is assigned to me
  dailyDigest        Boolean         @default(true) // 8 am summary on working days
  calendarTokenHash  String?         @unique // SHA-256 of the private calendar feed token
  // Two-step sign-in (authenticator app)
  totpSecret         String? // AES-256-GCM encrypted base32 secret
  totpEnabledAt      DateTime?
  totpLastStep       Int? // last accepted 30-second step, so a code can't be used twice
  recoveryCodeHashes String[]        @default([]) // SHA-256 of unused one-time recovery codes
  // Profile photo: the image itself is in UserAvatar so ordinary user queries stay small.
  avatarUpdatedAt    DateTime? // also the cache-busting version in the photo's URL
  avatar             UserAvatar?
  // Signature printed on documents this person seals (Admins and Managers). Image is in UserSignature.
  signatureUpdatedAt DateTime?
  signature          UserSignature?
  documentSeals      DocumentSeal[]  @relation("DocumentSealer")
  accessChecks       ProjectAccess[] @relation("AccessCheckedBy")
  handoversIssued    Handover[]      @relation("HandoverIssuer")
  invoicesCreated    Invoice[]       @relation("InvoiceCreator")
  paymentsRecorded   Payment[]       @relation("PaymentRecorder")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  ownedCompanies     Company[]       @relation("CompanyOwner")
  ownedContacts      Contact[]       @relation("ContactOwner")
  ownedLeads         Lead[]          @relation("LeadOwner")
  ownedDeals         Deal[]          @relation("DealOwner")
  assignedActivities Activity[]      @relation("ActivityAssignee")
  createdActivities  Activity[]      @relation("ActivityCreator")
  notes              Note[]
  auditLogs          AuditLog[]
  quotes             Quote[]
  ownedContracts     Contract[]      @relation("ContractOwner")
  assignedTickets    Ticket[]        @relation("TicketAssignee")
  createdTickets     Ticket[]        @relation("TicketCreator")
  ticketComments     TicketComment[]

  @@index([managerId])
}

// ─────────────────────────────────────────────────────────────
// Accounts & people
// ─────────────────────────────────────────────────────────────

model Company {
  id           String      @id @default(cuid())
  name         String
  type         CompanyType @default(PROSPECT)
  industry     String?
  website      String?
  email        String?
  phone        String?
  employeeSize String? // e.g. "1-10", "11-50"
  addressLine  String?
  city         String?
  country      String?
  taxId        String? // VAT / BR number
  description  String?
  ownerId      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  owner      User?      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  leads      Lead[]
  activities Activity[]
  notes      Note[]
  quotes     Quote[]
  contracts  Contract[]
  tickets    Ticket[]
  invoices   Invoice[]

  @@index([name])
  @@index([type])
  @@index([ownerId])
}

model Contact {
  id          String            @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  mobile      String?
  jobTitle    String?
  department  String?
  linkedinUrl String?
  isPrimary   Boolean           @default(false) // primary contact for the company
  language    PreferredLanguage @default(ENGLISH)
  companyId   String?
  ownerId     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner      User?      @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities Activity[]
  notes      Note[]
  quotes     Quote[]
  contracts  Contract[]
  tickets    Ticket[]
  invoices   Invoice[]

  @@index([companyId])
  @@index([email])
  @@index([lastName, firstName])
}

// ─────────────────────────────────────────────────────────────
// Sales: leads, pipelines, deals
// ─────────────────────────────────────────────────────────────

model Lead {
  id               String            @id @default(cuid())
  title            String // e.g. "E-commerce mobile app for ABC Retail"
  contactName      String?
  email            String?
  phone            String?
  whatsapp         String?
  companyName      String?
  language         PreferredLanguage @default(ENGLISH)
  source           LeadSource        @default(OTHER)
  serviceType      ServiceType?
  status           LeadStatus        @default(NEW)
  respondBy        DateTime? // reply promise: 2 working days after the enquiry
  respondedAt      DateTime? // first reply sent to the lead
  disqualifyReason String?
  estimatedValue   Decimal?          @db.Decimal(14, 2)
  currency         String            @default("LKR")
  description      String?
  ownerId          String?
  createdById      String? // who added it (website leads: nobody)
  companyId        String? // set when linked to an existing company
  convertedAt      DateTime?
  convertedDeal    Deal?             @relation("LeadConversion")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  owner      User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy  User?      @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activities Activity[]
  notes      Note[]

  @@index([status])
  @@index([ownerId])
  @@index([createdById])
  @@index([respondBy])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages PipelineStage[]
  deals  Deal[]
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(0) // win probability % used for forecasting
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id                String       @id @default(cuid())
  title             String
  value             Decimal      @default(0) @db.Decimal(14, 2)
  currency          String       @default("LKR")
  status            DealStatus   @default(OPEN)
  serviceType       ServiceType?
  pipelineId        String
  stageId           String
  stageChangedAt    DateTime     @default(now())
  companyId         String?
  contactId         String?
  ownerId           String?
  createdById       String?
  leadId            String?      @unique
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  description       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage      PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company    Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User?          @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("DealCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lead       Lead?          @relation("LeadConversion", fields: [leadId], references: [id], onDelete: SetNull)
  activities Activity[]
  notes      Note[]
  quotes     Quote[]
  contracts  Contract[]
  access     ProjectAccess?
  invoices   Invoice[]

  @@index([stageId])
  @@index([status])
  @@index([ownerId])
  @@index([createdById])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────
// Activities, notes, audit
// ─────────────────────────────────────────────────────────────

model Activity {
  id           String           @id @default(cuid())
  type         ActivityType
  subject      String
  description  String?
  priority     ActivityPriority @default(MEDIUM)
  dueAt        DateTime?
  completedAt  DateTime?
  assignedToId String?
  createdById  String?
  companyId    String?
  contactId    String?
  leadId       String?
  dealId       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignedTo User?    @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // History survives if a company or contact is deleted; it's removed with its lead or deal.
  @@index([assignedToId, completedAt, dueAt])
  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
}

model Note {
  id        String   @id @default(cuid())
  body      String
  authorId  String?
  companyId String?
  contactId String?
  leadId    String?
  dealId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. "create", "update", "delete", "login"
  entity    String // e.g. "Company", "Contact"
  entityId  String?
  summary   String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Quotes & catalogue
// ─────────────────────────────────────────────────────────────

/**
 * A service or product we quote often, with a standard price.
 */
model Product {
  id          String       @id @default(cuid())
  name        String
  description String?
  unit        String       @default("project") // project, hour, day, month, page, licence…
  unitPrice   Decimal      @db.Decimal(14, 2)
  currency    String       @default("LKR")
  serviceType ServiceType?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  quoteItems QuoteItem[]

  @@index([isActive, name])
}

model Quote {
  id              String      @id @default(cuid())
  number          String      @unique // Q-2026-0001
  title           String
  status          QuoteStatus @default(DRAFT)
  currency        String      @default("LKR")
  issueDate       DateTime
  validUntil      DateTime?
  introduction    String? // shown at the top of the quote
  terms           String? // payment terms, delivery, warranty…
  notes           String? // internal only, never printed
  discountPercent Decimal     @default(0) @db.Decimal(5, 2) // whole-quote discount
  taxLabel        String      @default("VAT")
  taxRate         Decimal     @default(0) @db.Decimal(5, 2)
  // Totals are worked out on the server from the lines and stored for lists and reports.
  subtotal        Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal     @default(0) @db.Decimal(14, 2)
  total           Decimal     @default(0) @db.Decimal(14, 2)
  dealId          String?
  companyId       String?
  contactId       String?
  createdById     String?
  sentAt          DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  deal      Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     QuoteItem[]
  invoices  Invoice[]
  seal      DocumentSeal?

  @@index([status])
  @@index([dealId])
  @@index([companyId])
  @@index([createdById])
  @@index([createdAt])
}

model QuoteItem {
  id              String  @id @default(cuid())
  quoteId         String
  position        Int
  productId       String?
  title           String
  description     String?
  quantity        Decimal @db.Decimal(12, 2)
  unit            String  @default("project")
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

/**
 * Named counters, e.g. "quote-2026" for quote numbers.
 */
model Counter {
  key   String @id
  value Int    @default(0)
}

/**
 * Softro's own details, printed on quotes. A single row with id "default".
 */
model OrgSettings {
  id                  String    @id @default("default")
  companyName         String    @default("Softro Code Labs")
  address             String?
  phone               String?
  email               String?
  website             String?
  registrationNo      String? // business registration (BR) number
  vatNumber           String? // TIN / VAT number, if registered
  defaultTaxLabel     String    @default("VAT")
  defaultTaxRate      Decimal   @default(0) @db.Decimal(5, 2)
  defaultValidityDays Int       @default(14)
  defaultTerms        String?
  invoiceDueDays      Int       @default(14) // invoices are due this many days after the invoice date
  invoiceTerms        String? // printed on invoices, e.g. how to pay
  bankDetails         String?
  quoteFooter         String?
  // Team chat (Slack, Google Chat, Discord or Teams incoming webhook)
  chatWebhookUrl      String?
  chatNotifyLeads     Boolean   @default(true) // new website leads
  chatNotifyWins      Boolean   @default(true) // deals won
  chatNotifyTickets   Boolean   @default(true) // urgent and high-priority tickets
  digestLastRunAt     DateTime?
  digestLastSent      Int?
  requireTwoFactor    Boolean   @default(false) // admins and managers must use two-step sign-in
  updatedAt           DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Contracts & support
// ─────────────────────────────────────────────────────────────

/**
 * An ongoing agreement with a client: maintenance, hosting, retainer, subscription…
 */
model Contract {
  id                String         @id @default(cuid())
  number            String         @unique // C-2026-0001
  title             String
  type              ContractType   @default(MAINTENANCE)
  status            ContractStatus @default(ACTIVE)
  companyId         String
  contactId         String?
  dealId            String?
  ownerId           String?
  startDate         DateTime
  endDate           DateTime? // empty = open-ended
  billingCycle      BillingCycle   @default(MONTHLY)
  amount            Decimal        @default(0) @db.Decimal(14, 2) // per billing cycle
  currency          String         @default("LKR")
  autoRenew         Boolean        @default(false)
  renewalNoticeDays Int            @default(30)
  responseTimeHours Int? // SLA: first response to a support ticket
  includedHours     Decimal?       @db.Decimal(8, 2) // support hours per month
  scope             String? // what's covered, printed nowhere, for the team
  renewedFromId     String?        @unique
  renewalTaskId     String? // the "renew this contract" task we created
  endedAt           DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  owner       User?     @relation("ContractOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  renewedFrom Contract? @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedTo   Contract? @relation("ContractRenewal")
  tickets     Ticket[]
  invoices    Invoice[]

  @@index([status, endDate])
  @@index([companyId])
}

/**
 * A client support request.
 */
model Ticket {
  id              String         @id @default(cuid())
  number          String         @unique // T-2026-0001
  subject         String
  description     String?
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  channel         TicketChannel  @default(WHATSAPP)
  companyId       String?
  contactId       String?
  contractId      String?
  assignedToId    String?
  createdById     String?
  responseDueAt   DateTime? // SLA: when we must first reply by
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company    Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contract   Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?           @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments   TicketComment[]

  @@index([status, priority])
  @@index([assignedToId, status])
  @@index([companyId])
  @@index([contractId])
}

model TicketComment {
  id            String   @id @default(cuid())
  ticketId      String
  authorId      String?
  body          String
  /**
   * true = a reply we sent the client (counts as our response); false = internal note
   */
  isClientReply Boolean  @default(false)
  createdAt     DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/// Fixed-window counters for rate limiting (sign-in attempts, website form, 2FA codes).
/// Stored in the database so limits hold across serverless instances.
model RateLimit {
  key     String   @id // e.g. "login:ip:1.2.3.4"
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

/// Server errors, grouped by fingerprint so a repeating error is one row with a count.
model ErrorEvent {
  id          String    @id @default(cuid())
  fingerprint String    @unique
  message     String
  stack       String?
  path        String?
  method      String?
  digest      String?
  count       Int       @default(1)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  alertedAt   DateTime?
  resolvedAt  DateTime?

  @@index([lastSeenAt])
}

/// A person's profile photo: 256×256 WebP, re-encoded on upload (no EXIF or location data). ~10–25 KB.
// A person's signature, as a transparent PNG (ink only).
model UserSignature {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  updatedAt DateTime @updatedAt
}

// The company seal applied to one quote, invoice or receipt by an Admin or Manager.
// Name, title and signature are copied at sealing time, so the document never changes afterwards.
model DocumentSeal {
  id          String   @id @default(cuid())
  quoteId     String?  @unique
  invoiceId   String?  @unique
  paymentId   String?  @unique // a receipt
  sealedById  String?
  signerName  String
  signerTitle String?
  signature   Bytes // transparent PNG
  sealedAt    DateTime @default(now())

  quote    Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment  Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sealedBy User?    @relation("DocumentSealer", fields: [sealedById], references: [id], onDelete: SetNull)
}

model UserAvatar {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  updatedAt DateTime @updatedAt
}

// ─── Project access register ─────────────────────────────────────────────────
// Where each project's accounts live and how they're protected. No passwords, keys or codes:
// those stay in the company password manager, and the CRM refuses text that looks like a secret.

enum AccessStatus {
  ACTIVE
  ARCHIVED
}

enum TwoStepMethod {
  AUTHENTICATOR
  SECURITY_KEY
  SMS
  NONE
}

enum ServiceCategory {
  DOMAIN
  HOSTING
  CODE
  DATABASE
  EMAIL
  PAYMENTS
  STORAGE
  ANALYTICS
  OTHER
}

enum SignInMethod {
  GOOGLE
  GITHUB
  PASSWORD_IN_GOOGLE
  OTHER
}

enum AccountOwner {
  SOFTRO
  CLIENT
  SHARED
}

model ProjectAccess {
  id                 String        @id @default(cuid())
  dealId             String        @unique
  status             AccessStatus  @default(ACTIVE)
  // The project's Google account: everything else is signed up with it
  googleEmail        String?
  recoveryEmail      String?
  recoveryPhone      String?
  twoStep            TwoStepMethod @default(AUTHENTICATOR)
  secretsLocation    String? // where the Gmail password and backup codes are kept, e.g. "Google Password Manager · backup codes in company Drive"
  envLocation        String? // where the settings live, e.g. "Vercel project settings; Drive /env"
  notes              String?
  // Close-out checklist
  passwordsSaved     Boolean       @default(false)
  backupCodesSaved   Boolean       @default(false)
  envSaved           Boolean       @default(false)
  clientHandedOver   Boolean       @default(false)
  browserProfileGone Boolean       @default(false)
  localFilesDeleted  Boolean       @default(false)
  // 6-monthly sign-in check (Google can delete personal accounts unused for 2 years)
  lastCheckedAt      DateTime?
  lastCheckedById    String?
  reviewTaskId       String?
  archivedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  deal          Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lastCheckedBy User?            @relation("AccessCheckedBy", fields: [lastCheckedById], references: [id], onDelete: SetNull)
  services      ProjectService[]
  handovers     Handover[]

  @@index([status])
}

model ProjectService {
  id            String          @id @default(cuid())
  accessId      String
  name          String
  category      ServiceCategory @default(OTHER)
  url           String?
  loginEmail    String?
  signIn        SignInMethod    @default(GOOGLE)
  owner         AccountOwner    @default(SOFTRO)
  renewsAt      DateTime?
  renewalTaskId String?
  notes         String?
  position      Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  access ProjectAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)

  @@index([accessId])
  @@index([renewsAt])
}

/// A handover document given to the client. Its content is frozen when issued, so it re-downloads exactly the same.
model Handover {
  id         String   @id @default(cuid())
  number     String   @unique // H-2026-0001
  accessId   String
  issuedById String?
  issuedAt   DateTime @default(now())
  snapshot   Json

  access   ProjectAccess @relation(fields: [accessId], references: [id], onDelete: Cascade)
  issuedBy User?         @relation("HandoverIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([accessId])
}

// ─── Invoices and receipts ───────────────────────────────────────────────────

enum InvoiceStatus {
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  ONLINE
  OTHER
}

/// An invoice. "Tax Invoice" when Softro has a VAT number. Totals use the same maths as quotes.
model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique // INV-2026-0001
  title           String
  status          InvoiceStatus @default(ISSUED)
  currency        String        @default("LKR")
  issueDate       DateTime
  dueDate         DateTime?
  terms           String? // payment instructions, printed
  notes           String? // internal only
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  taxLabel        String        @default("VAT")
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @db.Decimal(14, 2)
  total           Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid      Decimal       @default(0) @db.Decimal(14, 2)
  dealId          String?
  companyId       String?
  contactId       String?
  quoteId         String? // made from this quote (advance, balance or full)
  contractId      String? // or for this maintenance/hosting contract
  createdById     String?
  followUpTaskId  String? // "chase payment" task, closed when paid
  paidAt          DateTime?
  voidedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  deal      Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quote     Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  contract  Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     InvoiceItem[]
  payments  Payment[]
  seal      DocumentSeal?

  @@index([status])
  @@index([dueDate])
  @@index([dealId])
  @@index([companyId])
  @@index([quoteId])
  @@index([issueDate])
}

model InvoiceItem {
  id              String  @id @default(cuid())
  invoiceId       String
  position        Int
  title           String
  description     String?
  quantity        Decimal @db.Decimal(12, 2)
  unit            String  @default("project")
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Money received against an invoice. Each payment gets its own receipt number.
model Payment {
  id            String        @id @default(cuid())
  receiptNumber String        @unique // RCT-2026-0001
  invoiceId     String
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod @default(BANK_TRANSFER)
  paidAt        DateTime
  reference     String? // bank reference, cheque number…
  notes         String?
  recordedById  String?
  createdAt     DateTime      @default(now())

  invoice    Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User?         @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  seal       DocumentSeal?

  @@index([invoiceId])
  @@index([paidAt])
}
