// Softro Code Labs CRM — database schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN // full access, user management, settings
  MANAGER // sees and edits everything, reports
  SALES // works on own leads/deals, sees all companies/contacts
  SUPPORT // tickets, contracts (later phases), read-only sales data
  VIEWER // read-only
}

enum CompanyType {
  PROSPECT
  CUSTOMER
  PARTNER
  VENDOR
  FORMER_CUSTOMER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum LeadSource {
  WEBSITE_FORM // "Start your project" form on softrocodelabs.com (via /api/leads)
  WHATSAPP
  WEBSITE
  REFERRAL
  LINKEDIN
  EMAIL
  PHONE
  EVENT
  COLD_OUTREACH
  PARTNER
  UPWORK_FIVERR
  OTHER
}

// Matches the services on softrocodelabs.com and its "What would you like to build?" form
enum ServiceType {
  WEBSITE_WEB_APP
  MOBILE_APP
  ONLINE_STORE
  BUSINESS_SYSTEM // ERP, CRM, inventory/POS, booking systems
  AI_AUTOMATION
  CUSTOM_SOFTWARE
  SAAS_PLATFORM // SaaS, LMS, cloud platforms
  LAB_PRODUCT // Softro's own products, e.g. Surelane
  MAINTENANCE_SUPPORT
  NOT_SURE
}

enum PreferredLanguage {
  ENGLISH
  SINHALA
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  TASK
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum ActivityPriority {
  LOW
  MEDIUM
  HIGH
}

// ─────────────────────────────────────────────────────────────
// Users & access
// ─────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               Role      @default(SALES)
  isActive           Boolean   @default(true)
  jobTitle           String?
  phone              String?
  lastLoginAt        DateTime?
  // Security
  mustChangePassword Boolean   @default(false) // set for new users and after an admin reset
  sessionVersion     Int       @default(0) // bump to sign the user out everywhere
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? // temporary lock after too many wrong passwords
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  ownedCompanies     Company[]  @relation("CompanyOwner")
  ownedContacts      Contact[]  @relation("ContactOwner")
  ownedLeads         Lead[]     @relation("LeadOwner")
  ownedDeals         Deal[]     @relation("DealOwner")
  assignedActivities Activity[] @relation("ActivityAssignee")
  createdActivities  Activity[] @relation("ActivityCreator")
  notes              Note[]
  auditLogs          AuditLog[]
  quotes             Quote[]
}

// ─────────────────────────────────────────────────────────────
// Accounts & people
// ─────────────────────────────────────────────────────────────

model Company {
  id           String      @id @default(cuid())
  name         String
  type         CompanyType @default(PROSPECT)
  industry     String?
  website      String?
  email        String?
  phone        String?
  employeeSize String? // e.g. "1-10", "11-50"
  addressLine  String?
  city         String?
  country      String?
  taxId        String? // VAT / BR number
  description  String?
  ownerId      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  owner      User?      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  leads      Lead[]
  activities Activity[]
  notes      Note[]
  quotes     Quote[]

  @@index([name])
  @@index([type])
  @@index([ownerId])
}

model Contact {
  id          String            @id @default(cuid())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  mobile      String?
  jobTitle    String?
  department  String?
  linkedinUrl String?
  isPrimary   Boolean           @default(false) // primary contact for the company
  language    PreferredLanguage @default(ENGLISH)
  companyId   String?
  ownerId     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner      User?      @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities Activity[]
  notes      Note[]
  quotes     Quote[]

  @@index([companyId])
  @@index([email])
  @@index([lastName, firstName])
}

// ─────────────────────────────────────────────────────────────
// Sales: leads, pipelines, deals
// ─────────────────────────────────────────────────────────────

model Lead {
  id               String            @id @default(cuid())
  title            String // e.g. "E-commerce mobile app for ABC Retail"
  contactName      String?
  email            String?
  phone            String?
  whatsapp         String?
  companyName      String?
  language         PreferredLanguage @default(ENGLISH)
  source           LeadSource        @default(OTHER)
  serviceType      ServiceType?
  status           LeadStatus        @default(NEW)
  respondBy        DateTime? // reply promise: 2 working days after the enquiry
  respondedAt      DateTime? // first reply sent to the lead
  disqualifyReason String?
  estimatedValue   Decimal?          @db.Decimal(14, 2)
  currency         String            @default("LKR")
  description      String?
  ownerId          String?
  companyId        String? // set when linked to an existing company
  convertedAt      DateTime?
  convertedDeal    Deal?             @relation("LeadConversion")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  owner      User?      @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activities Activity[]
  notes      Note[]

  @@index([status])
  @@index([ownerId])
  @@index([respondBy])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages PipelineStage[]
  deals  Deal[]
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int      @default(0) // win probability % used for forecasting
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id                String       @id @default(cuid())
  title             String
  value             Decimal      @default(0) @db.Decimal(14, 2)
  currency          String       @default("LKR")
  status            DealStatus   @default(OPEN)
  serviceType       ServiceType?
  pipelineId        String
  stageId           String
  stageChangedAt    DateTime     @default(now())
  companyId         String?
  contactId         String?
  ownerId           String?
  leadId            String?      @unique
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  description       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage      PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company    Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User?         @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lead       Lead?         @relation("LeadConversion", fields: [leadId], references: [id], onDelete: SetNull)
  activities Activity[]
  notes      Note[]
  quotes     Quote[]

  @@index([stageId])
  @@index([status])
  @@index([ownerId])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────
// Activities, notes, audit
// ─────────────────────────────────────────────────────────────

model Activity {
  id           String           @id @default(cuid())
  type         ActivityType
  subject      String
  description  String?
  priority     ActivityPriority @default(MEDIUM)
  dueAt        DateTime?
  completedAt  DateTime?
  assignedToId String?
  createdById  String?
  companyId    String?
  contactId    String?
  leadId       String?
  dealId       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignedTo User?    @relation("ActivityAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact    Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  // History survives if a company or contact is deleted; it's removed with its lead or deal.
  @@index([assignedToId, completedAt, dueAt])
  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
}

model Note {
  id        String   @id @default(cuid())
  body      String
  authorId  String?
  companyId String?
  contactId String?
  leadId    String?
  dealId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId])
  @@index([leadId])
  @@index([dealId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. "create", "update", "delete", "login"
  entity    String // e.g. "Company", "Contact"
  entityId  String?
  summary   String?
  meta      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Quotes & catalogue
// ─────────────────────────────────────────────────────────────

/**
 * A service or product we quote often, with a standard price.
 */
model Product {
  id          String       @id @default(cuid())
  name        String
  description String?
  unit        String       @default("project") // project, hour, day, month, page, licence…
  unitPrice   Decimal      @db.Decimal(14, 2)
  currency    String       @default("LKR")
  serviceType ServiceType?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  quoteItems QuoteItem[]

  @@index([isActive, name])
}

model Quote {
  id              String      @id @default(cuid())
  number          String      @unique // Q-2026-0001
  title           String
  status          QuoteStatus @default(DRAFT)
  currency        String      @default("LKR")
  issueDate       DateTime
  validUntil      DateTime?
  introduction    String? // shown at the top of the quote
  terms           String? // payment terms, delivery, warranty…
  notes           String? // internal only, never printed
  discountPercent Decimal     @default(0) @db.Decimal(5, 2) // whole-quote discount
  taxLabel        String      @default("VAT")
  taxRate         Decimal     @default(0) @db.Decimal(5, 2)
  // Totals are worked out on the server from the lines and stored for lists and reports.
  subtotal        Decimal     @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(14, 2)
  taxTotal        Decimal     @default(0) @db.Decimal(14, 2)
  total           Decimal     @default(0) @db.Decimal(14, 2)
  dealId          String?
  companyId       String?
  contactId       String?
  createdById     String?
  sentAt          DateTime?
  acceptedAt      DateTime?
  declinedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  deal      Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact   Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdBy User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     QuoteItem[]

  @@index([status])
  @@index([dealId])
  @@index([companyId])
  @@index([createdAt])
}

model QuoteItem {
  id              String  @id @default(cuid())
  quoteId         String
  position        Int
  productId       String?
  title           String
  description     String?
  quantity        Decimal @db.Decimal(12, 2)
  unit            String  @default("project")
  unitPrice       Decimal @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal @db.Decimal(14, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

/**
 * Named counters, e.g. "quote-2026" for quote numbers.
 */
model Counter {
  key   String @id
  value Int    @default(0)
}

/**
 * Softro's own details, printed on quotes. A single row with id "default".
 */
model OrgSettings {
  id                  String   @id @default("default")
  companyName         String   @default("Softro Code Labs")
  address             String?
  phone               String?
  email               String?
  website             String?
  registrationNo      String? // business registration (BR) number
  vatNumber           String? // TIN / VAT number, if registered
  defaultTaxLabel     String   @default("VAT")
  defaultTaxRate      Decimal  @default(0) @db.Decimal(5, 2)
  defaultValidityDays Int      @default(14)
  defaultTerms        String?
  bankDetails         String?
  quoteFooter         String?
  updatedAt           DateTime @updatedAt
}
