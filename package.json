    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "geist": "^1.9.2",
    "jose": "^6.2.17",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
